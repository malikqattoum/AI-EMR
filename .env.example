MESSENGER_PAGE_ID=

# Chatbot Configuration
CHATBOT_AI_ENABLED=true
CHATBOT_DEFAULT_MODEL=gpt-4o-mini
CHATBOT_MAX_CONVERSATION_AGE_HOURS=24

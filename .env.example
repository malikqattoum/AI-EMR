OPENAI_REQUEST_TIMEOUT=
OPENAI_PRIMARY_MODEL=
OPENAI_FALLBACK_MODEL=

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT_ID=

# AI Configuration
AI_ENABLED=true
AI_PRESCRIPTION_SUGGESTIONS_ENABLED=true
AI_PRESCRIPTION_FALLBACK_ENABLED=true
